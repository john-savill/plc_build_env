@startyaml DRAFT PLC build environment process

# style configuration # 

<style>
    .h1 {
      BackGroundColor Yellow
    }
</style>

#highlight "jobs" / "validate"
#highlight "jobs" / "build"
#highlight "jobs" / "verify"
#highlight "jobs" / "deploy"

#highlight "on" / "schedule" <<h1>>
#highlight "jobs" / "build" / "if" <<h1>>
#highlight "jobs" / "verify" / "if" <<h1>>
#highlight "jobs" / "deploy" / "if" <<h1>>

# style configuration # 

name: Structured Text CI/CD

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  schedule:
    - cron: '0 0 * * *' 

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Validate Structured Text Requirements

  build:
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name == 'schedule' 
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Build Structured Text Project

  verify:
    runs-on: ubuntu-latest
    needs: build
    if: github.event_name == 'schedule'
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        
      - name: Run Program Verification Tests

  deploy:
    runs-on: ubuntu-latest
    needs: verify
    if: github.event_name == 'schedule'
    steps:
      - name: Deploy to Target Environment

      - name: Cleanup

@endyaml